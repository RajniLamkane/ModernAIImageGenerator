@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AI Image Generator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Inter', sans-serif;
                background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.35), transparent 35%), radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.30), transparent 35%), linear-gradient(135deg, #09090f, #111827 50%, #0f172a);
                color: #fff;
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 50px 20px;
            }

            .generator-card {
                width: 100%;
                max-width: 850px;
                padding: 45px;
                border-radius: 28px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                box-shadow: 0 25px 80px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
            }

            .logo {
                width: 70px;
                height: 70px;
                margin: 0 auto 20px;
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                background: linear-gradient(135deg, #8b5cf6, #3b82f6);
                box-shadow: 0 12px 35px rgba(99, 102, 241, 0.4);
            }

            .title {
                text-align: center;
                font-size: 42px;
                font-weight: 800;
                letter-spacing: -1.5px;
                margin-bottom: 10px;
                background: linear-gradient(90deg, #fff, #c4b5fd, #93c5fd);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .subtitle {
                text-align: center;
                color: #a5b4fc;
                font-size: 16px;
                margin-bottom: 38px;
            }

            .prompt-label {
                font-size: 14px;
                font-weight: 600;
                color: #e5e7eb;
                margin-bottom: 10px;
            }

            .prompt-wrapper {
                position: relative;
            }

            .prompt-input {
                width: 100%;
                min-height: 125px;
                resize: vertical;
                padding: 18px 20px;
                padding-right: 50px;
                color: #fff;
                font-size: 16px;
                border-radius: 16px;
                border: 1px solid rgba(255,255,255,0.15);
                outline: none;
                background: rgba(0, 0, 0, 0.25);
                transition: all 0.25s ease;
            }

                .prompt-input::placeholder {
                    color: #6b7280;
                }

                .prompt-input:focus {
                    border-color: #8b5cf6;
                    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15);
                    background: rgba(0, 0, 0, 0.35);
                }

            .magic-icon {
                position: absolute;
                right: 18px;
                top: 18px;
                font-size: 20px;
                opacity: 0.7;
            }

            .examples {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-top: 14px;
            }

            .example-chip {
                cursor: pointer;
                padding: 7px 12px;
                border-radius: 50px;
                font-size: 12px;
                color: #c4b5fd;
                background: rgba(139, 92, 246, 0.10);
                border: 1px solid rgba(139, 92, 246, 0.25);
                transition: all 0.2s ease;
            }

                .example-chip:hover {
                    background: rgba(139, 92, 246, 0.25);
                    transform: translateY(-1px);
                }

            .generate-btn {
                width: 100%;
                margin-top: 25px;
                padding: 15px 20px;
                border: none;
                border-radius: 15px;
                color: white;
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
                background: linear-gradient(135deg, #8b5cf6, #6366f1, #3b82f6);
                box-shadow: 0 12px 30px rgba(99, 102, 241, 0.35);
                transition: all 0.25s ease;
            }

                .generate-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 16px 35px rgba(99, 102, 241, 0.5);
                }

                .generate-btn:active {
                    transform: translateY(0);
                }

            .btn-icon {
                margin-right: 8px;
            }

            .loading-card {
                display: none;
                margin-top: 25px;
                padding: 20px;
                border-radius: 15px;
                text-align: center;
                background: rgba(99, 102, 241, 0.10);
                border: 1px solid rgba(139, 92, 246, 0.20);
            }

            .spinner {
                width: 32px;
                height: 32px;
                margin: 0 auto 12px;
                border: 3px solid rgba(255,255,255,0.2);
                border-top-color: #a78bfa;
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
            }

            .loading-text {
                color: #c4b5fd;
                font-size: 14px;
                margin: 0;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .error-card {
                margin-top: 25px;
                padding: 15px 18px;
                border-radius: 14px;
                color: #fecaca;
                background: rgba(239, 68, 68, 0.12);
                border: 1px solid rgba(239, 68, 68, 0.25);
            }

            .result-section {
                margin-top: 40px;
                padding-top: 35px;
                border-top: 1px solid rgba(255,255,255,0.10);
            }

            .result-title {
                text-align: center;
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 20px;
            }

            .image-card {
                padding: 10px;
                border-radius: 20px;
                background: rgba(255,255,255,0.07);
                border: 1px solid rgba(255,255,255,0.12);
                box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            }

            .generated-image {
                display: block;
                width: 100%;
                max-width: 650px;
                max-height: 650px;
                object-fit: contain;
                margin: auto;
                border-radius: 14px;
            }

            .download-btn {
                display: inline-block;
                margin-top: 20px;
                padding: 11px 20px;
                border-radius: 12px;
                color: #fff;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                background: rgba(255,255,255,0.10);
                border: 1px solid rgba(255,255,255,0.15);
                transition: 0.2s;
            }

                .download-btn:hover {
                    color: white;
                    background: rgba(255,255,255,0.18);
                }

            .footer-text {
                text-align: center;
                margin-top: 30px;
                color: #6b7280;
                font-size: 12px;
            }

            @@media (max-width: 600px) {

                .generator-card {
                    padding: 28px 20px;
                    border-radius: 22px;
                }

                .title {
                    font-size: 32px;
                }

                .subtitle {
                    font-size: 14px;
                }

                .logo {
                    width: 60px;
                    height: 60px;
                    font-size: 26px;
                }
            }

    </style>
</head>

<body>

    <div class="page-wrapper">

        <div class="generator-card">

            <div class="logo">
                ✨
            </div>

            <h1 class="title">
                AI Image Generator
            </h1>

            <p class="subtitle">
                Turn your imagination into stunning visuals with AI
            </p>

            <form method="post"
                  asp-controller="AiImageGen"
                  asp-action="Generate"
                  id="imageForm">

                <label class="prompt-label">
                    Describe your image
                </label>

                <div class="prompt-wrapper">

                    <textarea name="prompt"
                              id="prompt"
                              class="prompt-input"
                              placeholder="Describe what you want to create..."
                              required>@ViewBag.Prompt</textarea>

                    <span class="magic-icon">
                        ✨
                    </span>

                </div>

                <div class="examples">

                    <span class="example-chip"
                          onclick="setPrompt('A futuristic city at sunset, cinematic lighting')">
                        🌆 Futuristic city
                    </span>

                    <span class="example-chip"
                          onclick="setPrompt('A magical forest with glowing flowers and fireflies')">
                        🌲 Magical forest
                    </span>

                    <span class="example-chip"
                          onclick="setPrompt('A cute astronaut cat floating in space, digital art')">
                        🚀 Astronaut cat
                    </span>

                    <span class="example-chip"
                          onclick="setPrompt('A beautiful ancient castle on a mountain at sunrise')">
                        🏰 Fantasy castle
                    </span>

                </div>

                <button type="submit"
                        class="generate-btn"
                        id="generateBtn">

                    <span class="btn-icon">✨</span>
                    Generate Image

                </button>

            </form>

            <div id="loading"
                 class="loading-card">

                <div class="spinner"></div>

                <p class="loading-text">
                    Creating your masterpiece...
                </p>

                <small style="color:#6b7280;">
                    This may take a few moments
                </small>

            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-card">⚠️ @ViewBag.Error</div>
            }

            @if (ViewBag.ImageUrl != null)
            {
                <div class="result-section">

                    <h2 class="result-title">
                        ✨ Your Generated Image
                    </h2>

                    <div class="image-card">

                        <img src="@ViewBag.ImageUrl"
                             alt="AI Generated Image"
                             class="generated-image" />

                    </div>

                    <div class="text-center">

                        <a href="@ViewBag.ImageUrl"
                               target="_blank"
                               class="download-btn">
                            ↗ Open Full Image
                        </a>

                    </div>

                </div>
            }

            <div class="footer-text">
                Powered by AI • Create anything you can imagine
            </div>

        </div>

    </div>

    <script>

            const form = document.getElementById("imageForm");
            const loading = document.getElementById("loading");
            const generateBtn = document.getElementById("generateBtn");

            form.addEventListener("submit", function () {

                loading.style.display = "block";

                generateBtn.disabled = true;

                generateBtn.innerHTML =
                    '<span class="btn-icon">⏳</span> Generating...';

                window.scrollTo({
                    top: document.body.scrollHeight,
                    behavior: "smooth"
                });

            });

            function setPrompt(text) {
                document.getElementById("prompt").value = text;
                document.getElementById("prompt").focus();
            }

    </script>

</body>
</html>